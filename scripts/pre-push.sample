#!/bin/sh
# Sample pre-push hook: stop a push that would publish a home path, a personal email,
# an assistant session transcript or a case identifier.
#
# It is a sample. Nothing installs it. To use it in your own clone:
#   cp scripts/pre-push.sample .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# It scans the commits the push would add (messages and added lines), not the whole
# history. Environment:
#   LEAK_SCAN_PATTERNS  file of private case patterns, kept outside the repository
#                       (see the header of scripts/leak_scan.py for the format)
#   LEAK_SCAN_PY        path to leak_scan.py (default: scripts/leak_scan.py in this repo)
#   PYTHON              interpreter (default: python3)
#
# Any nonzero exit from the scanner blocks the push, including exit 2 (a patterns file
# that is missing or invalid), so a broken setup never lets a push through unchecked.
# Bypass once, deliberately, with `git push --no-verify`.

zero=0000000000000000000000000000000000000000
remote=${1:-origin}
root=$(git rev-parse --show-toplevel) || exit 1
scan=${LEAK_SCAN_PY:-$root/scripts/leak_scan.py}
python=${PYTHON:-python3}
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a ref pushes no commits.
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
    else
        # A new ref, or a remote tip this clone does not have: scan everything the
        # remote's known branches lack.
        range="$local_sha --not --remotes=$remote"
    fi
    echo "leak_scan: $local_ref -> $remote_ref ($range)" >&2
    "$python" "$scan" --repo "$root" --range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
    echo "push blocked: leak_scan found something (or could not run). Fix it, or use --no-verify on purpose." >&2
fi
exit "$status"
