{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matter-kit.dev/schema/v0.json",
  "title": "Matter Kit — canonical matter entities (v0)",
  "type": "object",
  "$defs": {
    "StatusLabel": {
      "description": "Evidence/record custody status.",
      "enum": ["verified", "needs-source", "unverified", "superseded", "excluded"]
    },
    "AssertionLabel": {
      "description": "Epistemic label every substantive claim must carry. Agents may not upgrade a label without a new source.",
      "enum": ["DOCUMENTED FACT", "ALLEGATION", "INFERENCE", "HYPOTHESIS", "UNKNOWN"]
    },
    "Document": {
      "type": "object",
      "required": ["id", "sha256", "rel_path"],
      "properties": {
        "id": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rel_path": { "type": "string" },
        "bytes": { "type": "integer" },
        "mtime": { "type": "number" },
        "kind": {
          "type": "string",
          "enum": ["filing", "evidence", "correspondence", "research", "tracker", "media", "admin", "other"]
        },
        "source_url": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "Capture": {
      "description": "One retrieval of a URL. rel_path names the Document holding those bytes; a re-retrieval of unchanged bytes is a new row against the same rel_path.",
      "type": "object",
      "required": ["url", "retrieved_at", "sha256", "rel_path"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rel_path": { "type": "string" }
      }
    },
    "CorrespondenceNotice": {
      "description": "A custodian notice, separate from counsel outreach. Addressee must reference a Party with role agency|other and capacity custodian. Only DOCUMENTED FACT and UNKNOWN assertions enter generated letter bodies. Receipt hashes record operator-supplied evidence; software never sends.",
      "type": "object",
      "required": ["id", "kind", "status", "addressee", "address", "exhibit_document_id", "exhibit_sha256", "transport", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["hold", "mpra", "foia", "touhy", "letter", "other"] },
        "status": { "enum": ["draft", "signed", "mailed", "receipt-hashed", "answered", "refused"] },
        "addressee": { "type": "string", "description": "Custodian Party ID; never an outreach recipient ID." },
        "address": { "type": "string", "minLength": 1 },
        "exhibit_document_id": { "type": "string" },
        "exhibit_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assertion_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "confirm_due": { "type": ["string", "null"], "format": "date" },
        "deadline_id": { "type": ["string", "null"] },
        "transport": { "const": "nosend" },
        "approval_id": { "type": ["string", "null"] },
        "receipt_document_id": { "type": ["string", "null"] },
        "receipt_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["signed", "mailed", "receipt-hashed", "answered", "refused"] } } },
          "then": { "required": ["approval_id"], "properties": { "approval_id": { "type": "string" } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["mailed", "receipt-hashed", "answered", "refused"] } } },
          "then": {
            "required": ["receipt_document_id", "receipt_sha256"],
            "properties": { "receipt_document_id": { "type": "string" }, "receipt_sha256": { "type": "string" } }
          }
        }
      ]
    },
    "CorrespondenceEvidence": {
      "description": "An append-only lifecycle history row. Mailing proof, delivery confirmation, answers, and refusals keep distinct evidence hashes. created_at is recording time, not a claim about delivery time.",
      "type": "object",
      "required": ["id", "notice_id", "to_status", "recorded_by", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "notice_id": { "type": "string" },
        "from_status": { "type": ["string", "null"] },
        "to_status": { "enum": ["draft", "signed", "mailed", "receipt-hashed", "answered", "refused"] },
        "evidence_document_id": { "type": ["string", "null"] },
        "evidence_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "approval_id": { "type": ["string", "null"] },
        "recorded_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "Assertion": {
      "type": "object",
      "required": ["id", "text", "status"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "status": { "$ref": "#/$defs/AssertionLabel" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["document_id"],
            "properties": {
              "document_id": { "type": "string" },
              "locator": { "type": "string", "description": "page, paragraph, timecode, or quote anchor" }
            }
          }
        },
        "contested_by": { "type": "array", "items": { "type": "string" } },
        "created_by": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "Deadline": {
      "type": "object",
      "required": ["id", "label", "due_date"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "due_date": { "type": "string", "format": "date" },
        "rule_source": { "type": "string", "description": "the rule/order/statute that creates this deadline" },
        "confidence": { "enum": ["hard", "working-estimate"] },
        "verification_status": { "enum": ["verified-official", "secondary-source", "unverified"] },
        "state": { "enum": ["open", "met", "missed", "moot"] }
      }
    },
    "Event": {
      "type": "object",
      "required": ["id", "occurred_on", "text"],
      "properties": {
        "id": { "type": "string" },
        "occurred_on": { "type": "string" },
        "text": { "type": "string" },
        "actors": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Party": {
      "type": "object",
      "required": ["id", "name", "role"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "enum": ["plaintiff", "defendant", "witness", "counsel", "court", "agency", "other"] },
        "capacity": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "Issue": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "supporting_assertions": { "type": "array", "items": { "type": "string" } },
              "gap": { "type": "boolean" }
            }
          }
        },
        "status": { "enum": ["pleaded", "considered", "quarantined", "abandoned"] }
      }
    },
    "Authority": {
      "type": "object",
      "required": ["id", "citation"],
      "properties": {
        "id": { "type": "string" },
        "citation": { "type": "string" },
        "status": { "enum": ["unverified", "verified", "not-found", "contradicted"] },
        "checked_via": { "type": "string", "description": "corpuslaw.us node_id, CourtListener id, reporter lookup…" },
        "note": { "type": "string" }
      }
    }
  }
}
